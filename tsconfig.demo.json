  "include": ["netlify/functions/services/demo/**/*.ts", "netlify/functions/demo-*.ts", "tests/demo/**/*.ts", "tests/demo/**/*.tsx", "src/features/demo/**/*.ts", "src/pages/Demo.tsx", "vitest.config.ts"]
}
