# Example environment file.
#
# Copy to `.env` and fill in the values for your environment:
#
#   cp .env.example .env
#
# `.env` is git-ignored and must never be committed. This file is the
# documented shape of the variables the app expects.
#
# VITE_ variables are baked into the client bundle at build time, so they
# are public by definition. Only ever put PUBLISHABLE or ANON keys here --
# never the service_role key or any other secret.

# The Supabase project id, e.g. "abcdefghijklmnopqrst"
VITE_SUPABASE_PROJECT_ID=

# The project's API URL, e.g. "https://abcdefghijklmnopqrst.supabase.co"
VITE_SUPABASE_URL=

# The publishable (or legacy anon) API key. This is public: it is embedded
# in the browser bundle and protected by row-level security.
VITE_SUPABASE_PUBLISHABLE_KEY=

# The Netlify site URL, e.g. "https://example.netlify.app"
VITE_NETLIFY_URL=
